# Linux: Brave запускается отдельно с CDP портом 9222.
# Эти пути не управляют браузером ChatGPT; нужны для совместимости с настройками.
BRAVE_PATH="/usr/bin/brave-browser"
BOT_PROFILE="runtime/brave-profile"
SCREENSHOT_PATH="runtime/chatgpt_screenshot.png"
GPT_TIMEOUT=30000
GPT_DOWNLOADS="runtime/gpt-downloads"
MAX_BOT_TOKEN=
TAXI_PROFILE="runtime/yandex-taxi-profile"
TAXI_ADDRESS_BOOK="runtime/taxi-addresses.json"
TAXI_SCREENSHOT="runtime/taxi-screenshot.png"
TAXI_URL="https://taxi.yandex.ru/"
MEDIA_DIR="runtime/media"
MAX_EXTRACTED_FILES=200
MAX_EXTRACTED_BYTES=536870912
WHISPER_MODEL="small"
ABIE_REPO_URL="https://github.com/kalentivan/abie.git"
ABIE_SNAPSHOT_DIR="runtime/snapshots"
